   "translations": [
    {
     "language_code": "eng",
     "text": [
      "All glories to the son of Mother Yaśodā, Kṛṣṇa, who maintains and gives pleasure to the cows, gopas, and gopīs. All glories to the enchanter of Cupid, Hari, who is infinite and awards salvation."
     ]
    }
   ],
