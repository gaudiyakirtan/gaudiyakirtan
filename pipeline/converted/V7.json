   "translations": [
    {
     "language_code": "eng",
     "text": [
      "O worshipful Vaiṣṇavas, I humbly submit this prayer to you. I am an extremely fallen and wicked soul, and my fate is causing me to drown in the terrible ocean of material existence. Take hold of the hair on my head and rescue me from this ocean."
     ]
    }
   ],
