   "translations": [
    {
     "language_code": "eng",
     "text": [
      "All glories to the son of Nanda Mahārāja, the beloved of the gopīs and the hero of Rādhā, the gallant Śyāma. That [very same] son of Śacī is the monarch of Nadīyā and the abode of all beauty who enchants the minds of the gods and sages."
     ]
    }
   ],
