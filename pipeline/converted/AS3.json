      "गौर गुणमणि आमार निताइ गुणमणि;",
      "शुद्ध भकतर सङ्ग, धरि क्ड़्ष्ण परसङ्ग",
      "करि महारङ्गॆ माता दिबस रजनी १"
     ]
    },
    {
     "script_code": "Beng",
     "standard": null,
