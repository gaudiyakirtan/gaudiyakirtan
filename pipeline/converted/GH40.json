   "source_text_master": [
    "gaurāṅgera du’ṭī pada,    yā’ra dhana sampada,",
    "se jāne bhakati[FLAG_HYPHEN_ALPHA]rasasāra",
    "gaurāṅgera madhura līlā,    yā’ra karṇe prabeśilā,",
    "hṛdaya nirmala bhela tā’ra 1"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "That person for whom the two lotus feet of Śrī Gaurāṅga are his wealth and property knows the essence of bhakti-rasa. That person for whom the sweet pastimes of Gaurāṅga have entered the ears is pure in heart."
     ]
    }
   ],
