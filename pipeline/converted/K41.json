   "translations": [
    {
     "language_code": "eng",
     "text": [
      "That person's birth is successful if, by good fortune, he has Kṛṣṇa's darśana just once. By seeing Kṛṣṇa with the opened eyes of the heart, the jīva abandons all perversions of consciousness."
     ]
    }
   ],
