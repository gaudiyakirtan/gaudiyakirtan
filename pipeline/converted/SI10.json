    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "यॊगपीठॊपरि स्थित,    अष्टसखीसुबॆष्टित,",
      "ब्ड़्न्दारण्यॆ कदम्बकाननॆ",
