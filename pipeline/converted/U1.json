   "translations": [
    {
     "language_code": "eng",
     "text": [
      "O Hari! Having fallen into the material world of five elements and become helpless, I see no solace other than the shelter of Your feet, for You are the resort of the helpless. I have made You my all in all."
     ]
    }
   ],
