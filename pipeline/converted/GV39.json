   "verse_number": 1,
   "source_text_master": [
    "śrīrūpera baḓa bhāi,    śrīsanātana gosāi,",
    "pātsāra ujira ha·iyā chilā",
    "śrīrūpera patra pe’ye,    bandī haite palāiye,",
    "kāśīpure gaurāṅga bheṭilā 1"
