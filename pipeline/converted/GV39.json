   "display_scripts": [
    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "श्रीरूपॆर बḓअ भाइ,    श्रीसनातन गॊसाइ,",
      "पात्सार उजिर हइया छिला",
      "श्रीरूपॆर पत्र पॆऽयॆ,    बन्दी हैतॆ पलाइयॆ,",
      "काशीपुरॆ गौराङ्ग भॆटिला १"
     ]
    },
    {
     "script_code": "Beng",
     "standard": null,
     "text": [
      "শ্রীরূপের বḓঅ ভাই,    শ্রীসনাতন গোসাই,",
      "পাৎসার উজির হইয়া ছিলা",
      "শ্রীরূপের পত্র পেঽয়ে,    বন্দী হৈতে পলাইয়ে,",
      "কাশীপুরে গৌরাঙ্গ ভেটিলা ১"
     ]
    },
    {
     "script_code": "Orya",
