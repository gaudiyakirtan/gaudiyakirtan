   "display_scripts": [
    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "रूपानुगानां प्रवरं सुदान्तं",
      "श्रीगौरचन्द्रप्रियभक्तराजम्",
      "श्रीराधिकामाधवचित्तरामं",
