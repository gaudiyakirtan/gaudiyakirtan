    },
    {
     "script_code": "Beng",
     "standard": null,
     "text": [
      "রূপানুগানাং প্রবরং সুদান্তং",
      "শ্রীগৌরচন্দ্রপ্রিয়ভক্তরাজম্",
      "শ্রীরাধিকামাধবচিত্তরামং",
