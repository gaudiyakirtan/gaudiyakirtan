   "source_text_master": [
    "anādi karama[FLAG_HYPHEN_ALPHA]phale,    paḓi’ bhabārṇaba[FLAG_HYPHEN_ALPHA]jale,",
    "taribāre nā dekhi’ upāya",
    "e biṣaya[FLAG_HYPHEN_ALPHA]halāhale,    dibā[FLAG_HYPHEN_ALPHA]niśi hiyā jbale,",
    "mana kabhu sukha nāhi pāya 1"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "In consequence to my actions since time immemorial, I have plunged into the ocean of material existence and see no means of deliverance. Due to the poison of worldly pleasures, my heart blazes day and night and my mind never receives any comfort."
     ]
    }
   ],
