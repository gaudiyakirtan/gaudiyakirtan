   "source_text_master": [
    "mocā[FLAG_HYPHEN_ALPHA]ghaṇṭa phulabaḓi,    ḍāli[FLAG_HYPHEN_ALPHA]ḍāl‌nā[FLAG_HYPHEN_ALPHA]caccaḓi,",
