   "source_text_master": [
    "bhāire!",
    "śacīra aṅgane kabhu,    mādhabendrapurī prabhu,",
    "prasādānna karena bhojana",
    "khāite khāite tā̃’ra,    āila prema sudurbāra,",
    "bale—“śuna, sannyāsīra gaṇa 1"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "O brothers! Once, Śrīla Mādhavendra Purī was taking prasādam at Mother Śacī’s house. As he ate, overwhelming prema rose within him, and he exclaimed, “Attention, all renunciants!"
     ]
    }
   ],
