   "source_text_master": [
    "āre bhāi! bhaja mora gaurāṅga[FLAG_HYPHEN_ALPHA]caraṇa",
    "nā bhajiyā mainu duḥkhe,    ḍubi’ gṛha[FLAG_HYPHEN_ALPHA]biṣakūpe,",
    "dagdha kaila e pā̃ca parāṇa 1"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "O my dear brother, just worship the lotus feet of my Lord Gaurāṅga! Because I have not performed such worship, I am dying of sorrow. Having plunged into the poisonous well of household life, my five life-airs are burning."
     ]
    }
   ],
