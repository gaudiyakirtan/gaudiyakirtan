    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "शरीरॆर सुखॆ, मन, दॆह जलाञ्जलि",
      "ऎ दॆह तॊमार नय,    बरञ्च ऎ शत्रु हय,",
      "सिद्धदॆहसाधनसमयॆ",
      "सर्बदा इहार बलॆ रहियाछ बली",
      "किन्तु नाहि जान मन,    ऎ शरीर अचॆतन,",
      "पḓऎ रय जीबनबिलयॆ १"
     ]
    },
    {
