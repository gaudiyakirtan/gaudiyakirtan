   "translations": [
    {
     "language_code": "eng",
     "text": [
      "O Hari! Having forgotten You, my tongue is afflicted with the jaundice of ignorance. The ambrosia of the holy name of Kṛṣṇa is unpleasant for me, as I am engrossed in worldly pleasures."
     ]
    }
