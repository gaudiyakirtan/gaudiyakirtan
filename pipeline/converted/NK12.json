   "source_text_master": [
    "kaliyugapābana biśbambhara",
    "gauḓacittagagana[FLAG_HYPHEN_ALPHA]śaśadhara",
    "kīrtana[FLAG_HYPHEN_ALPHA]bidhātā,    parapremadātā,",
    "śacīsuta puraṭasundara"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "Śrī Viśvambhara is the savior of this age of Kali, the full moon in the sky of the hearts of the inhabitants of Gauḓa-deśa, and the inaugurator of kīrtana. He bestows the highest kind of prema, He is the son of Mother Śacī, and He has a beautiful golden complexion."
     ]
    }
   ],
