   "translations": [
    {
     "language_code": "eng",
     "text": [
      "“Upon one’s tasting this śāk, kṛṣṇa-prema arises in one’s heart. Relish this śāk with love. Forgetting your materialistic conceptions and taking the Lord’s remnants, all of you just chant, ‘Hari! Hari!’ ”"
     ]
    }
   ],
