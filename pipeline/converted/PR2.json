   "verse_number": 1,
   "source_text_master": [
    "bhāire!",
    "ekadina śāntipure,    prabhu adbaitera ghare,",
    "dui prabhu bhojane basila",
    "śāka kari’ āsbādana,    prabhu bale,—“bhaktagaṇa,",
    "ei śāka kṛṣṇa āsbādila 1"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "O brothers! One day at Śrī Advaita Prabhu’s house in Śāntipura, the two Lords (Śrī Caitanya and Śrī Nityānanda) sat for lunch. Upon tasting the śāk (leafy green vegetable preparation), Lord Caitanya said, “O devotees, this śāk has certainly been enjoyed by Kṛṣṇa!"
     ]
    }
   ],
