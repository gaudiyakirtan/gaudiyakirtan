   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "One who has failed to worship with great care Śrīmatī Rādhikā’s lotus feet, which are the treasure-house of all auspiciousness; who has not taken shelter of that abode called Śrī Vṛndāvana, which is decorated with the imprints of Rādhā’s lotus feet…"
     ]
    }
   ],
