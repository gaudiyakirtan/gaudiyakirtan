   "translations": [
    {
     "language_code": "eng",
     "text": [
      "He revels with Rādhā, He is the Lord of Rādhā, and He basks in the radiance of Rādhā. He is the relisher of Rādhā, the lover of Rādhā, and He thrills in uniting with Rādhā."
     ]
    }
