   "translations": [
    {
     "language_code": "eng",
     "text": [
      "I do not know how much sweetness fills this name of Śyāma, for my tongue cannot leave it. As I go on repeating this name, I lose control of myself. O sakhī! How shall I ever be able to meet Him?"
     ]
    }
