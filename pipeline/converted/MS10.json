    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "ब्रजभूमि चिन्तामणि,    चिदानन्दरत्नखनि,",
      "यथा नित्य रसॆर बिलास",
      "‘जीबॆ दिब गूḓह धनऽ,    चिन्तिऽ क्ड़्ष्ण ब्ड़्न्दाबन,",
      "जḓऎ आनिऽ करिल प्रकाश १"
     ]
    },
    {
     "script_code": "Beng",
     "standard": null,
     "text": [
