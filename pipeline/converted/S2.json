   "verse_number": 1,
   "source_text_master": [
    "bhuliyā tomāre,    saṁsāre āsiyā,",
    "peye nānābidha byathā",
    "tomāra caraṇe,    āsiyāchi āmi,",
    "baliba duḥkhera kathā 1"
