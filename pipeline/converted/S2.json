   "translations": [
    {
     "language_code": "eng",
     "text": [
      "Forgetting You and falling into worldliness, I have suffered many pains. Now, falling at Your feet, I shall tell You my woeful tale."
     ]
    }
   ],
   "display_scripts": [
    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "भुलिया तॊमारॆ,    संसारॆ आसिया,",
      "पॆयॆ नानाबिध ब्यथा",
      "तॊमार चरणॆ,    आसियाछि आमि,",
      "बलिब दुःखॆर कथा १"
     ]
    },
    {
     "script_code": "Beng",
     "standard": null,
