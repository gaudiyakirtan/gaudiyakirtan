  {
   "verse_number": 2,
   "source_text_master": [
    "baiṣṇaba[FLAG_HYPHEN_ALPHA]śarīra,    aprākṛta sadā,",
    "sbabhāba[FLAG_HYPHEN_ALPHA]bapura dharme",
    "kabhu nahe jaḓa,    tathāpi ye ninde,",
    "paḓe se biṣamādharme 2"
   ],
   "translations": [
    {
     "language_code": "eng",
     "text": [
      "Similarly, the body of the Vaiṣṇava is always transcendental. From any perspective, his nature and body are never mundane. As such, one who criticizes him falls into consummate heresy."
     ]
    }
   ],
