    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "अपूर्ब बैष्णबतत्त्ब! आत्मार आनन्द",
      "प्रस्रबण! नाहि याऽर तुलना संसारॆ",
      "स्बधर्म बलिया याऽर आछॆ परिचय",
      "ऎ जगतॆ! ऎ तत्त्बॆर शुन बिबरण",
      "परब्रह्म सनातन, आनन्दस्बरूप",
      "नित्यकाल रसरूप, रसॆर आधार—",
      "परात्पर, अद्बितीय, अनन्त, अपार",
      "तथापि स्बरूपतत्त्ब, शक्तिशक्तिमान्,",
      "लीलारसपराकाष्ठा, आश्रयस्बरूप",
      "तर्क कि सॆतत्त्ब कभु स्पर्शिबारॆ पारॆ ?",
      "रसतत्त्ब सुगम्भीर! समाधिआश्रयॆ",
      "उपलब्ध! आहा मरि, समाधि कि धन!!",
      "समाधिस्थ हऽयॆ दॆख, सुस्थिर अन्तरॆ,",
      "हॆ साधक! रसतत्त्ब अखण्ड आनन्द,",
      "किन्तु ताहॆ आस्बादकआस्बाद्यबिधान,",
      "नित्यधर्म अनुस्यूत! अद्बितीय प्रभु,",
      "आस्बादक क्ड़्ष्णरूप,—आस्बाद्य राधिका,",
      "द्बैतानन्द! परानन्दपीठ ब्ड़्न्दाबन!",
      "प्राक्ड़्त जगतॆ यांऽर प्रकाशबिशॆष,",
      "यॊगमाया प्रकाशिता! तांहार आश्रयॆ",
      "लभिछॆ साधकब्ड़्न्द नित्य प्रॆमतत्त्ब—",
      "आदर्श, याहार नाम बिकुण्ठकल्याण !!",
      "यदि याह नित्यानन्दप्रबाह सॆबितॆ",
      "अबिरत, गुरुपादाश्रय करऽ जीब!",
      "निरस भजन समुदय परिहरिऽ—",
      "ब्रह्मचिन्ता आदि यत, सदा साधऽ रति,",
      "कुसुमित ब्ड़्न्दाबनॆ श्रीरासमण्डलॆ",
      "पुरुषत्बअहङ्कार नितान्त दुर्बल",
      "तब  तुमि शुद्ध जीब  आस्बाद्य स्बजन,",
      "श्रीराधार नित्यसखी! परानन्दरस",
      "अनुभबिऽ! मायाभॊग तॊमार पतन!!",
      "(श्रील भक्तिबिनॊद ठाकुर)"
     ]
    },
