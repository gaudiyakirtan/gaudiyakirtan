   "display_scripts": [
    {
     "script_code": "Deva",
     "standard": null,
     "text": [
      "“पूर्णचिदानन्द तुमि,    तॊमार चित्कण आमि,",
      "स्बभाबतः आमि तुया दास",
      "परम स्बतन्त्र तुमि,    तुया परतन्त्र आमि,",
      "तुया पद छाḓइऽ सर्बनाश १"
     ]
    },
    {
     "script_code": "Beng",
     "standard": null,
     "text": [
      "“পূর্ণচিদানন্দ তুমি,    তোমার চিৎকণ আমি,",
      "স্বভাবতঃ আমি তুয়া দাস",
      "পরম স্বতন্ত্র তুমি,    তুয়া পরতন্ত্র আমি,",
