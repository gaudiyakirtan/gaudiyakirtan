      "ಬಲ್ಲವೆಶಸೂನುಸರ್ವವಾಂಛಿತಾರ್ಥಸಾಧಿಕಾ",
      "ಮಹ್ಯಮಾತ್ಮ್ಯಪಾದಪದ್ಮದಾಸ್ಯದಾಸ್ತು ರಾಧಿಕಾ ೧"
     ]
    },
    {
