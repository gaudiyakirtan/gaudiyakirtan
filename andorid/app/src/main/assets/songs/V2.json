  "verses": [
    {
      "verse_number": 1,
      "source_text_master": [
        "ṭhākura baiṣṇaba[FLAG_HYPHEN_ALPHA]pada,    abanīra susampada,",
        "śuna bhāi, hayā ekamana",
        "āśraya la·iyā bhaje,    tāre kṛṣṇa nāhi tyaje,",
        "āra saba mare akāraṇa 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "The lotus feet of the venerable Vaiṣṇavas are the greatest treasure in the world. O brother, please listen with rapt attention. Śrī Kṛṣṇa never forsakes one who, having taken shelter of the Vaiṣṇavas, lovingly worships Him. All others perish without purpose."
          ]
        }
      ],
