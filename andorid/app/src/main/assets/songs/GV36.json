      "verse_number": 1,
      "source_text_master": [
        "yabe rūpa[FLAG_HYPHEN_ALPHA]sanātana,    braje gelā dui jana,",
        "śuna·ite raghunāthadāsa",
        "nijarājya adhikāra,    indrasama sukha yā̃’ra,",
        "chāḓiyā calilā prabhu[FLAG_HYPHEN_ALPHA]pāśa 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "यबॆ रूपसनातन,    ब्रजॆ गॆला दुइ जन,",
            "शुनइतॆ रघुनाथदास",
            "निजराज्य अधिकार,    इन्द्रसम सुख यांऽर,",
            "छाḓइया चलिला प्रभुपाश १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "যবে রূপসনাতন,    ব্রজে গেলা দুই জন,",
            "শুনইতে রঘুনাথদাস",
            "নিজরাজ্য অধিকার,    ইন্দ্রসম সুখ যাংঽর,",
            "ছাḓইয়া চলিলা প্রভুপাশ ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ଯବେ ରୂପସନାତନ,    ବ୍ରଜେ ଗେଲା ଦୁଇ ଜନ,",
            "ଶୁନଇତେ ରଘୁନାଥଦାସ",
            "ନିଜରାଜ୍ୟ ଅଧିକାର,    ଇନ୍ଦ୍ରସମ ସୁଖ ଯାଂଽର,",
            "ଛାḓଇୟା ଚଲିଲା ପ୍ରଭୁପାଶ ୧"
