            "सॆइ रात्रॆ तथाइ रहिला ३"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "একদিন একগ্রামে,    সন্ধ্যাকালে গোবাথানে,",
