        "khāichu ha·iyā kāmī 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "श्रीगुरुबैष्णब,    तॊमार चरण,",
            "स्मरण ना कैनु आमि",
            "बिषय बिषम,    बिष भाल मानि,",
            "खाइछु हइया कामी १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
