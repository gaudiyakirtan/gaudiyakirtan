      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "बन्धुसङ्गॆ यदि तब रङ्ग परिहास, थाकॆ अभिलाष",
            "(थाकॆ अभिलाष)",
            "तबॆ मॊर कथा राख,    यॆयॊ नाकॊ यॆयॊ नाकॊ,",
            "मथुराय कॆशीतीर्थघाटॆर सकाश १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "বন্ধুসঙ্গে যদি তব রঙ্গ পরিহাস, থাকে অভিলাষ",
            "(থাকে অভিলাষ)",
            "তবে মোর কথা রাখ,    যেয়ো নাকো যেয়ো নাকো,",
            "মথুরায় কেশীতীর্থঘাটের সকাশ ১"
          ]
        },
        {
          "script_code": "Orya",
