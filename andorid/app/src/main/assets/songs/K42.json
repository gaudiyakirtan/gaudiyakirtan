      "source_text_master": [
        "bandhusaṅge yadi taba raṅga parihāsa, thāke abhilāṣa",
        "(thāke abhilāṣa)",
        "tabe mora kathā rākha,    yeyo nāko yeyo nāko,",
        "mathurāya keśītīrtha[FLAG_HYPHEN_ALPHA]ghāṭera sakāśa 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "If you have the desire to have fun and laugh with friends, then heed my words: don’t go, do not go near Keśī-ghāṭa in Mathurā."
          ]
        }
      ],
