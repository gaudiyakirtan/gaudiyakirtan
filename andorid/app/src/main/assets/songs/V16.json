      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "मिछॆ मायाबशॆ,    संसारसागरॆ,",
            "पḓइया छिलाम आमि",
            "करुणा करिया,    दिया पदछाया,",
            "आमारॆ तारिलॆ तुमि १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "মিছে মায়াবশে,    সংসারসাগরে,",
            "পḓইয়া ছিলাম আমি",
            "করুণা করিয়া,    দিয়া পদছায়া,",
            "আমারে তারিলে তুমি ১"
