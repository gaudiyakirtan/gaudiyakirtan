      "source_text_master": [
        "mana, taba kena e saṁśaya ?",
        "jaḓa[FLAG_HYPHEN_ALPHA]prati ghṛṇā kari’,    bhajite premera hari,",
        "sbarūpa lakṣite kara’ bhaya 1"
