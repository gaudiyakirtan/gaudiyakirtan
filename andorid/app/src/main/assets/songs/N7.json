      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "निताइपदकमल,    कॊटीचन्द्रसुशीतल,",
            "यॆ छायाय जगत् जुḓआय",
            "हॆन निताइ बिनॆ भाइ,    राधाक्ड़्ष्ण पाइतॆ नाइ,",
            "द्ड़्ḓह करिऽ धर निताइर पाय १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "নিতাইপদকমল,    কোটীচন্দ্রসুশীতল,",
            "যে ছায়ায় জগৎ জুḓআয়",
            "হেন নিতাই বিনে ভাই,    রাধাক্ড়্ষ্ণ পাইতে নাই,",
            "দ্ড়্ḓহ করিঽ ধর নিতাইর পায় ১"
          ]
        },
        {
