  "verses": [
    {
      "verse_number": 1,
      "source_text_master": [
        "nitāi[FLAG_HYPHEN_ALPHA]pada[FLAG_HYPHEN_ALPHA]kamala,    koṭīcandra[FLAG_HYPHEN_ALPHA]suśītala,",
        "ye chāyāya jagat juḓāya",
        "hena nitāi bine bhāi,    rādhākṛṣṇa pāite nāi,",
        "dṛḓha kari’ dhara nitāira pāya 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "The lotus feet of Nitāi are as cooling as millions of moons. Their shade gives solace to the entire universe. Without a personality such as Nitāi, O brother, it is not possible to attain Rādhā and Kṛṣṇa, so firmly take hold of His lotus feet."
          ]
        }
      ],
