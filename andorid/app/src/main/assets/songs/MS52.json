      "verse_number": 1,
      "source_text_master": [
        "ore mana! kibā tumi bicāri nā cāo",
        "‘kṛṣṇa’ bhuli ei pāpa,    tẽha tora tina tāpa,",
        "nānā yoni bhramiyā beḓāo 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "ऒरॆ मन! किबा तुमि बिचारि ना चाऒ",
            "‘क्ड़्ष्णऽ भुलि ऎइ पाप,    त्ẽह तॊर तिन ताप,",
            "नाना यॊनि भ्रमिया बॆḓआऒ १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "ওরে মন! কিবা তুমি বিচারি না চাও",
            "‘ক্ড়্ষ্ণঽ ভুলি এই পাপ,    ৎẽহ তোর তিন তাপ,",
            "নানা যোনি ভ্রমিয়া বেḓআও ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
