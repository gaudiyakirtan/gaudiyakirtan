  "verses": [
    {
      "verse_number": 1,
      "source_text_master": [
        "rādhāballabha mādhaba śrīpati mukunda",
        "gopīnātha madanamohana rāsa[FLAG_HYPHEN_ALPHA]rasānanda",
        "anaṅga[FLAG_HYPHEN_ALPHA]sukhada[FLAG_HYPHEN_ALPHA]kuñjabihārī gobinda"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Kṛṣṇa is the beloved of Rādhā, He is controlled by Rādhā, He is the Lord of all beauty, and His face resembles a kunda flower. He is the Lord of the gopīs, He bewilders Cupid, He delights in the rasa of the rāsa-līlā, and revels in amorous play at Rādhā-kuṇḍa’s Anaṅga-sukhada-kuñja. He gives pleasure to the cows, gopas, and gopīs."
          ]
        }
      ],
