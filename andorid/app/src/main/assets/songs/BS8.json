      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "मनॆर माला जप्‌बि यखन, मन,",
            "कॆन कर्‌बि बाह्य बिसर्जन",
            "मनॆ मनॆ भजन यखन हय,",
            "प्रॆम उथ्‌लॆ पḓऎऽ बाह्यदॆहॆ ब्याप्त हऽयॆ रय ;",
            "आबार दॆहॆ चरॆ, जपाय करॆ, धराय माला अनुक्षण १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
