      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "रूपॆर गौरब कॆन भाइ ?",
            "अनित्य ऎ कलॆबर,    कभु नहॆ स्थिरतर,",
            "शमन आइलॆ किछु नाइ",
            "ऎ अङ्ग शीतल हऽबॆ,    आंखि स्पन्दहीन रऽबॆ,",
            "चितार आगुनॆ हऽबॆ छाइ १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "রূপের গৌরব কেন ভাই ?",
