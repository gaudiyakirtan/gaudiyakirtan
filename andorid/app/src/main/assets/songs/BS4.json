      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "दॆहतत्त्ब—जḓऎर तत्त्ब,",
            "ताऽतॆ कि छाḓआय मायार गर्त ?",
            "चिदानन्द परमार्थ,",
            "जान्‌तॆ तऽ ताय पार्‌बॆ ना २"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "দেহতত্ত্ব—জḓএর তত্ত্ব,",
            "তাঽতে কি ছাḓআয় মায়ার গর্ত ?",
            "চিদানন্দ পরমার্থ,",
            "জান্‌তে তঽ তায় পার্বে না ২"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ଦେହତତ୍ତ୍ବ—ଜḓଏର ତତ୍ତ୍ବ,",
            "ତାଽତେ କି ଛାḓଆୟ ମାୟାର ଗର୍ତ ?",
            "ଚିଦାନନ୍ଦ ପରମାର୍ଥ,",
            "ଜାନ୍‌ତେ ତଽ ତାୟ ପାର୍‌ବେ ନା ୨"
          ]
        },
        {
          "script_code": "Gujr",
