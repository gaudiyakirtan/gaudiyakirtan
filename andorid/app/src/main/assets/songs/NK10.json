  "verses": [
    {
      "verse_number": 1,
      "source_text_master": [
        "bhaja gaurāṅga kaha gaurāṅga",
        "laha gaurāṅgera nāma re",
        "ye jana gaurāṅga bhaje",
        "se haya āmāra prāṇa re"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "भज गौराङ्ग कह गौराङ्ग",
            "लह गौराङ्गॆर नाम रॆ",
            "यॆ जन गौराङ्ग भजॆ",
            "सॆ हय आमार प्राण रॆ"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "ভজ গৌরাঙ্গ কহ গৌরাঙ্গ",
            "লহ গৌরাঙ্গের নাম রে",
            "যে জন গৌরাঙ্গ ভজে",
            "সে হয় আমার প্রাণ রে"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ଭଜ ଗୌରାଙ୍ଗ କହ ଗୌରାଙ୍ଗ",
            "ଲହ ଗୌରାଙ୍ଗେର ନାମ ରେ",
            "ଯେ ଜନ ଗୌରାଙ୍ଗ ଭଜେ",
            "ସେ ହୟ ଆମାର ପ୍ରାଣ ରେ"
          ]
        },
        {
