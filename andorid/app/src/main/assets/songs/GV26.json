    {
      "script_code": "Beng",
      "text": "শ্রীল ৱিশ্ৱনাথ চক্রৱর্তী ঠাকুর"
    },
    {
      "script_code": "Latn",
      "standard": "IAST",
      "text": "Śrīla Viśvanātha Cakravartī Ṭhākura"
    },
    {
      "script_code": "Deva",
      "text": "श्रील विश्वनाथ चक्रवर्ती ठाकुर"
    },
    {
      "script_code": "Telu",
      "text": "శ్రీల విశ్వనాథ చక్రవర్తీ ఠాకుర"
    },
    {
      "script_code": "Knda",
      "text": "ಶ್ರೀಲ ವಿಶ್ವನಾಥ ಚಕ್ರವರ್ತೀ ಠಾಕುರ"
    },
    {
      "script_code": "Taml",
      "text": "ஶ்ரீல விஶ்வநாத² சக்ரவர்தீ டா²குர"
    },
    {
      "script_code": "Mlym",
      "text": "ശ്രീല വിശ്വനാഥ ചക്രവർതീ ഠാകുര"
    },
    {
      "script_code": "Gujr",
      "text": "શ્રીલ વિશ્વનાથ ચક્રવર્તી ઠાકુર"
    },
    {
      "script_code": "Orya",
      "text": "ଶ୍ରୀଲ ବିଶ୍ୱନାଥ ଚକ୍ରବର୍ତୀ ଠାକୁର"
    },
    {
      "script_code": "Cyrl",
      "text": "ш́рӣла виш́вана̄тха чакравартӣ т̣ха̄кура"
