      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Nityānanda Prabhu is my wealth, Śrī Gaura-candra is my master, and the youthful Divine Couple of Vraja are my very life. Advaita Ācārya is my strength, Gadādhara Paṇḍita is my family, and Narahari Sarakāra is my joy."
          ]
        }
      ],
