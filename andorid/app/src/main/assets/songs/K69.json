    {
      "verse_number": 1,
      "source_text_master": [
        "kṛṣṇera yateka khelā,    tāra madhye naralīlā,",
        "sarbottama rasera ālaya",
        "e rasa goloke nāi,    tabe bala kothā pāi,",
        "brajadhāma tāhāra nilaya 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "क्ड़्ष्णॆर यतॆक खॆला,    तार मध्यॆ नरलीला,",
            "सर्बॊत्तम रसॆर आलय",
            "ऎ रस गॊलॊकॆ नाइ,    तबॆ बल कॊथा पाइ,",
            "ब्रजधाम ताहार निलय १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "ক্ড়্ষ্ণের যতেক খেলা,    তার মধ্যে নরলীলা,",
            "সর্বোত্তম রসের আলয়",
            "এ রস গোলোকে নাই,    তবে বল কোথা পাই,",
            "ব্রজধাম তাহার নিলয় ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "କ୍ଡ଼୍ଷ୍ଣେର ଯତେକ ଖେଲା,    ତାର ମଧ୍ୟେ ନରଲୀଲା,",
            "ସର୍ବୋତ୍ତମ ରସେର ଆଲୟ",
            "ଏ ରସ ଗୋଲୋକେ ନାଇ,    ତବେ ବଲ କୋଥା ପାଇ,",
            "ବ୍ରଜଧାମ ତାହାର ନିଲୟ ୧"
          ]
        },
        {
          "script_code": "Gujr",
