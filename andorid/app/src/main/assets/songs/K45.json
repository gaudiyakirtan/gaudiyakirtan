      "verse_number": 1,
      "source_text_master": [
        "yamunā[FLAG_HYPHEN_ALPHA]puline,    kadamba[FLAG_HYPHEN_ALPHA]kānane,",
        "ki herinu sakhi! āja",
        "śyāma baṁśīdhārī,    maṇimañcopari,",
        "kare līlā rasarāja 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O sakhī! What have I seen today? In a kadamba grove on the banks of the Yamunā, a beautiful blackish flute player, seated upon a jeweled platform, is performing His pastimes as the king of all rasa."
          ]
        }
      ],
