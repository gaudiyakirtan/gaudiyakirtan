    {
      "verse_number": 2,
      "source_text_master": [
        "jaya jaya ‘rādhā’ nāma,    bṛndābana yā̃’ra dhāma,",
        "kṛṣṇasukha[FLAG_HYPHEN_ALPHA]bilāsera nidhi",
        "hena rādhā[FLAG_HYPHEN_ALPHA]guṇagāna,    nā śunila mora kāṇa,",
        "bañcita karila more bidhi 2"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "All glories to the name of Rādhā, whose abode is Śrī Vṛndāvana. She is the repository of loving pastimes that bring happiness to Śrī Kṛṣṇa. If my ears do not hear such narrations of Rādhā’s glories, then destiny has cheated me."
          ]
        }
      ],
