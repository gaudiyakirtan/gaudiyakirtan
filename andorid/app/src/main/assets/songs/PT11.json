      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "बिषयॆ सकलॆ मत्त,    नाहि क्ड़्ष्णनामतत्त्ब,",
            "भक्तिशून्य हइल अबनी",
            "कलिकालसर्पबिषॆ,    दग्ध जीब मिथ्यारसॆ,",
            "ना जानयॆ कॆबा सॆ आपनि १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "বিষয়ে সকলে মত্ত,    নাহি ক্ড়্ষ্ণনামতত্ত্ব,",
            "ভক্তিশূন্য হইল অবনী",
            "কলিকালসর্পবিষে,    দগ্ধ জীব মিথ্যারসে,",
            "না জানয়ে কেবা সে আপনি ১"
          ]
