    {
      "verse_number": 1,
      "source_text_master": [
        "śrīgopālabhaṭṭa prabhu,    tuyā śrīcaraṇa kabhu,",
        "dekhiba ki nayana bhariyā",
        "śuniyā asīma guṇa,    pā̃jare bindhila ghuṇa,",
        "nichani niyā yāire mariyā 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "श्रीगॊपालभट्ट प्रभु,    तुया श्रीचरण कभु,",
            "दॆखिब कि नयन भरिया",
            "शुनिया असीम गुण,    पांजरॆ बिन्धिल घुण,",
            "निछनि निया याइरॆ मरिया १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "শ্রীগোপালভট্ট প্রভু,    তুয়া শ্রীচরণ কভু,",
            "দেখিব কি নয়ন ভরিয়া",
            "শুনিয়া অসীম গুণ,    পাঞ্জরে বিন্ধিল ঘুণ,",
            "নিছনি নিয়া যাইরে মরিয়া ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ଶ୍ରୀଗୋପାଲଭଟ୍ଟ ପ୍ରଭୁ,    ତୁୟା ଶ୍ରୀଚରଣ କଭୁ,",
            "ଦେଖିବ କି ନୟନ ଭରିୟା",
            "ଶୁନିୟା ଅସୀମ ଗୁଣ,    ପାଞ୍ଜରେ ବିନ୍ଧିଲ ଘୁଣ,",
            "ନିଛନି ନିୟା ଯାଇରେ ମରିୟା ୧"
