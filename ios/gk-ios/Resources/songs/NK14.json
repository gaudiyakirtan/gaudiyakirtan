      "source_text_master": [
        "śrīkṛṣṇa gopāla hare mukunda",
        "gobinda he nanda kiśorakṛṣṇa",
        "hā śrīyaśodātanaya prasīda",
        "śrīballabījībana rādhikeśa"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O Śrī Kṛṣṇa! Gopāla! Hari! Mukunda! Govinda! O Nanda-kiśora Kṛṣṇa! Alas, O beloved son of Yaśodā, be pleased with me! O life of the gopīs! O Lord of Rādhikā!"
          ]
        }
      ],
