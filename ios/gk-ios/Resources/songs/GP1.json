      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Do bhajana, just do bhajana, my foolish mind! (Without bhajana, there is no other resort.) Worship the lotus feet of Rādhā-Kṛṣṇa in the forests of Vraja (giving up jñāna and karma)."
          ]
        }
