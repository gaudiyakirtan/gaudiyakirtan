      "source_text_master": [
        "bhaja re bhaja re āmāra mana ati manda",
        "(bhajana binā gati nāi re)",
        "(bhaja) brajabane rādhākṛṣṇa[FLAG_HYPHEN_ALPHA]caraṇārabinda 1",
