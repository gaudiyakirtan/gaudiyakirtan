      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "जिनिया रबिकर,    श्रीअङ्गसुन्दर,",
            "नयनॆ हॆरइ ना पारि",
            "आयत लॊचन,    इषत् बङ्किम,",
            "उपमा नाहिक बिचारि ध्रु"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "জিনিয়া রবিকর,    শ্রীঅঙ্গসুন্দর,",
            "নয়নে হেরই না পারি",
            "আয়ত লোচন,    ইষৎ বঙ্কিম,",
            "উপমা নাহিক বিচারি ধ্রু"
          ]
