        "kalitādbhuta[FLAG_HYPHEN_ALPHA]rasabhāram",
        "nivasatu nityamihāmṛta[FLAG_HYPHEN_ALPHA]nindini[FLAG_HYPHEN_ALPHA]",
        "vindanmadhurimasāram 3"
