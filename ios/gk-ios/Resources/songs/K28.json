      "verse_number": 1,
      "source_text_master": [
        "(kṛṣṇa) deva! bhavantaṁ vande",
        "manmānasa[FLAG_HYPHEN_ALPHA]madhukaramarpaya nijapada[FLAG_HYPHEN_ALPHA]",
        "paṅkaja[FLAG_HYPHEN_ALPHA]makarande dhru"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O Kṛṣṇa! O Deva! I am offering a prayer to You. Kindly place the bee of my mind within the honey of Your lotus feet."
          ]
        }
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
