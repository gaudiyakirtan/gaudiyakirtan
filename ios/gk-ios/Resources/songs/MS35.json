      "source_text_master": [
        "bhaja bhaja hari,    mana dṛḓha kari’,",
        "mukhe bola tā̃’ra nāma",
        "brajendranandana,    gopī[FLAG_HYPHEN_ALPHA]prāṇadhana,",
        "bhubanamohana śyāma 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Making your mind steady, worship Śrī Hari, and with your lips, chant His holy names: Vrajendra-nandana (son of the king of Vraja), Gopī-prāṇa-dhana (treasure of the life of the gopīs), and Śyāma (dark-complexioned one), whose beauty enchants the entire universe."
          ]
        }
      ],
