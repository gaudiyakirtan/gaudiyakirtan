      "verse_number": 1,
      "source_text_master": [
        "brajera nikuñja[FLAG_HYPHEN_ALPHA]bane,    rādhākṛṣṇa sakhīsane,",
        "līlārase nitya thāke bhora",
        "sei dainandina[FLAG_HYPHEN_ALPHA]līlā,    bahubhāgye ye sebilā,",
        "tāhāra bhāgyera baḓa jora 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "ब्रजॆर निकुञ्जबनॆ,    राधाक्ड़्ष्ण सखीसनॆ,",
            "लीलारसॆ नित्य थाकॆ भॊर",
            "सॆइ दैनन्दिनलीला,    बहुभाग्यॆ यॆ सॆबिला,",
            "ताहार भाग्यॆर बḓअ जॊर १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "ব্রজের নিকুঞ্জবনে,    রাধাক্ড়্ষ্ণ সখীসনে,",
            "লীলারসে নিত্য থাকে ভোর",
            "সেই দৈনন্দিনলীলা,    বহুভাগ্যে যে সেবিলা,",
            "তাহার ভাগ্যের বḓঅ জোর ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ବ୍ରଜେର ନିକୁଞ୍ଜବନେ,    ରାଧାକ୍ଡ଼୍ଷ୍ଣ ସଖୀସନେ,",
            "ଲୀଲାରସେ ନିତ୍ୟ ଥାକେ ଭୋର",
            "ସେଇ ଦୈନନ୍ଦିନଲୀଲା,    ବହୁଭାଗ୍ୟେ ଯେ ସେବିଲା,",
            "ତାହାର ଭାଗ୍ୟେର ବḓଅ ଜୋର ୧"
          ]
        },
        {
          "script_code": "Gujr",
          "standard": null,
