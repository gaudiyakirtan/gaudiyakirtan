    {
      "verse_number": 2,
      "source_text_master": [
        "sei mora rasanidhi,    sei mora bāñchāsiddhi,",
        "sei mora bedera dharama",
        "sei brata, sei tapaḥ,    sei mora mantra[FLAG_HYPHEN_ALPHA]japa,",
