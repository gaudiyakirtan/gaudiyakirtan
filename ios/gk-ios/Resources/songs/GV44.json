  "verses": [
    {
      "verse_number": 1,
      "source_text_master": [
        "śrīrūpamañjarī[FLAG_HYPHEN_ALPHA]pada,    sei mora sampada,",
        "sei mora bhajana[FLAG_HYPHEN_ALPHA]pūjana",
        "sei mora prāṇadhana,    sei mora ābharaṇa,",
        "sei mora jībanera jībana 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "The lotus feet of Śrī Rūpa Mañjarī are my treasure. They are [the sole object of] my bhajana and worship. Her lotus feet are the wealth of my life. They are the ornament of my life and, indeed, the very life of my life."
          ]
        }
      ],
