      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Her lotus feet are the treasure-house of rasa, the attainment of my desires, and the conclusion of all the Vedas. Her lotus feet are the goal of my vows and austerities, the object of my recitation of mantra, and the purpose of all my religious activities."
          ]
        }
      ],
