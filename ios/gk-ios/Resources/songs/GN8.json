      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "ऎ घॊरसंसारॆ,    पḓइया मानब,",
            "ना पाय दुःखॆर शॆष",
            "साधुसङ्ग करिऽ,    हरिभजॆ यदि,",
            "तबॆ अन्त हय क्लॆश १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
