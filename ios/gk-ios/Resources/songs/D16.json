    {
      "verse_number": 1,
      "source_text_master": [
        "karaṅga kaupīna layā,    chẽḓā kānthā gāye diyā,",
        "teyāgiba sakala biṣaya",
        "kṛṣṇe anurāga ha’be,    brajera nikuñje kabe,",
        "yāiyā kariba nijālaya 1"
