    {
      "verse_number": 2,
      "source_text_master": [
        "golokera premadhana,    harināma[FLAG_HYPHEN_ALPHA]saṅkīrtana,",
        "rati nā janmila kene tāya",
        "saṁsāra[FLAG_HYPHEN_ALPHA]biṣānale,    dibāniśi hiyā jbale,",
