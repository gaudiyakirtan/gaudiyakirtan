      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O Śrī Hari, be merciful and keep me at Your lotus feet. Six adversaries, headed by lust and anger, are dragging me to various places and causing me to gratify my senses in various ways."
          ]
        }
      ],
