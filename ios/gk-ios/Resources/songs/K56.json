      "verse_number": 1,
      "source_text_master": [
        "hari hari! kṛpā kari’ rākha nija pade",
        "kāma[FLAG_HYPHEN_ALPHA]krodha chaya jane,    layā phire nānāsthāne,",
        "biṣaya[FLAG_HYPHEN_ALPHA]bhuñjāya nānāmate 1"
