      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "हरि हॆ!",
            "परतत्त्ब बिचक्षण,    ब्यासआदि मुनिगण,",
            "शास्त्र बिचारिया बार बार",
            "प्रभु, तब नित्यरूप,    गुणशील अनुरूप,",
            "तॊमार चरित्र सुधासार १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "হরি হে!",
            "পরতত্ত্ব বিচক্ষণ,    ব্যাসআদি মুনিগণ,",
            "শাস্ত্র বিচারিয়া বার বার",
            "প্রভু, তব নিত্যরূপ,    গুণশীল অনুরূপ,",
            "তোমার চরিত্র সুধাসার ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
