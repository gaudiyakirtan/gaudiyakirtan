          "script_code": "Deva",
          "standard": null,
          "text": [
            "महाप्रभु भक्तगणॆ,    परम आनन्दमनॆ,",
            "आज्ञा दिल करितॆ भॊजन",
            "क्ड़्ष्णॆर प्रसादअन्न,    भॊजनॆ हइया धन्य,",
            "क्ड़्ष्ण बलिऽ डाकॆ सर्बजन २"
          ]
        },
