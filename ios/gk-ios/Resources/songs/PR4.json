      "source_text_master": [
        "bhāire!",
        "śrīcaitanya[FLAG_HYPHEN_ALPHA]nityānanda,    śrībāsādi bhaktabṛnda,",
        "gaurīdāsa[FLAG_HYPHEN_ALPHA]paṇḍitera ghare",
        "luci, cini, kṣīra, sara,    miṭhāi, pāyasa āra,",
        "piṭhāpānā āsbādana kare 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O brothers! Once, at the house of Gaurīdāsa Paṇḍit, Śrī Caitanya, Śrī Nityānanda, and Their devotees, headed by Śrīvāsa Ṭhākura, were relishing [various Bengali sweets such as] luci-cini (white-flour purīs dusted with sugar), kṣīra (sweetened condensed milk), sāra (thick cream), miṭhāi (sweet meats), pāyasa (sweet rice), and piṭhā-pānā (coconut cake rolls in sweetened condensed milk)."
          ]
        }
      ],
