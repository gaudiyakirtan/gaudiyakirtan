  "verses": [
    {
      "verse_number": 1,
      "source_text_master": [
        "‘dharma’ bali bede yāre,    eteka praśaṁsā kare,",
        "‘adharma’ baliyā ninde yā’re",
        "tāhā kichu nāhi kara,    dharmādharma parihara,",
        "hao rata nigūḓha byāpāre 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "‘धर्मऽ बलि बॆदॆ यारॆ,    ऎतॆक प्रशंसा करॆ,",
            "‘अधर्मऽ बलिया निन्दॆ याऽरॆ",
            "ताहा किछु नाहि कर,    धर्माधर्म परिहर,",
            "हऒ रत निगूḓह ब्यापारॆ १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "‘ধর্মঽ বলি বেদে যারে,    এতেক প্রশংসা করে,",
            "‘অধর্মঽ বলিয়া নিন্দে যাঽরে",
            "তাহা কিছু নাহি কর,    ধর্মাধর্ম পরিহর,",
            "হও রত নিগূḓহ ব্যাপারে ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "‘ଧର୍ମଽ ବଲି ବେଦେ ଯାରେ,    ଏତେକ ପ୍ରଶଂସା କରେ,",
            "‘ଅଧର୍ମଽ ବଲିୟା ନିନ୍ଦେ ଯାଽରେ",
            "ତାହା କିଛୁ ନାହି କର,    ଧର୍ମାଧର୍ମ ପରିହର,",
            "ହଓ ରତ ନିଗୂḓହ ବ୍ୟାପାରେ ୧"
          ]
        },
        {
          "script_code": "Gujr",
          "standard": null,
          "text": [
            "‘ધર્મઽ બલિ બેદે યારે,    એતેક પ્રશંસા કરે,",
            "‘અધર્મઽ બલિયા નિન્દે યાઽરે",
            "તાહા કિછુ નાહિ કર,    ધર્માધર્મ પરિહર,",
            "હઓ રત નિગૂḓહ બ્યાપારે ૧"
          ]
        },
        {
          "script_code": "Latn",
          "standard": "IAST",
          "text": [
            "‘dharma’ bali bede yāre,    eteka praśaṁsā kare,",
            "‘adharma’ baliyā ninde yā’re",
            "tāhā kichu nāhi kara,    dharmādharma parihara,",
            "hao rata nigūḓha byāpāre 1"
          ]
        },
        {
          "script_code": "Knda",
          "standard": null,
          "text": [
