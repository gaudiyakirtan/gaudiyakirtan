            "‘ಅಧರ್ಮಽ ಬಲಿಯಾ ನಿಂದೆ ಯಾಽರೆ",
            "ತಾಹಾ ಕಿಛು ನಾಹಿ ಕರ,    ಧರ್ಮಾಧರ್ಮ ಪರಿಹರ,",
            "ಹಒ ರತ ನಿಗೂḓಹ ಬ್ಯಾಪಾರೆ ೧"
          ]
        },
        {
          "script_code": "Telu",
