            "করাম্ভোজয়ুগ্মেন সাতঙ্কনেত্রম্",
            "মুহুঃশ্বাসকম্পত্ত্রিরেখাঙ্ককণ্ঠ",
            "স্থিতগ্রৈবদামোদরং ভক্তিবদ্ধম্ ২"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
