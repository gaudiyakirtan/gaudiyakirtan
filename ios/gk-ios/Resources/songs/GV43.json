    {
      "verse_number": 2,
      "source_text_master": [
        "nīra[FLAG_HYPHEN_ALPHA]kṣīra[FLAG_HYPHEN_ALPHA]haṁsana,    pāna[FLAG_HYPHEN_ALPHA]bidhāyana,",
