    {
      "verse_number": 2,
      "source_text_master": [
        "śrīrādhāra sukhe,    kṛṣṇera ye sukha,",
        "jāniba manete āmi",
        "rādhāpada chāḓi’,    śrīkṛṣṇa[FLAG_HYPHEN_ALPHA]saṅgame,",
