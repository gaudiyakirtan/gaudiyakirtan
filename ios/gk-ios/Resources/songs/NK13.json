        "kṛṣṇacaitanya adbaita prabhu nityānanda",
        "gadādhara śrīnibāsa murāri mukunda",
        "sbarūpa[FLAG_HYPHEN_ALPHA]rūpa[FLAG_HYPHEN_ALPHA]sanātana[FLAG_HYPHEN_ALPHA]purī[FLAG_HYPHEN_ALPHA]rāmānanda"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "[Chant the following names of Śrīman Mahāprabhu and His associates:] Śrī Kṛṣṇa Caitanya Mahāprabhu, Advaita Ācārya, Nityānanda Prabhu, Gadādhara Paṇḍita, Śrīvāsa Ṭhākura, Murāri Gupta, Mukunda Datta, Svarūpa Dāmodara Gosvāmī, Rūpa Gosvāmī, Sanātana Gosvāmī, Paramānanda Purī, Rāmānanda Rāya!"
          ]
        }
      ],
