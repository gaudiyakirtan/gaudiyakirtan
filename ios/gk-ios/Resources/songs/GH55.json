      "verse_number": 1,
      "source_text_master": [
        "kalighora timire,    garāsala jagajana,",
        "dharama karama rahu dūra",
        "asādhane cintāmaṇi,    bidhi milāola āni’,",
        "gorā baḓa dayāra ṭhākura 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "कलिघॊर तिमिरॆ,    गरासल जगजन,",
            "धरम करम रहु दूर",
            "असाधनॆ चिन्तामणि,    बिधि मिलाऒल आनिऽ,",
            "गॊरा बḓअ दयार ठाकुर १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "কলিঘোর তিমিরে,    গরাসল জগজন,",
            "ধরম করম রহু দূর",
            "অসাধনে চিন্তামণি,    বিধি মিলাওল আনিঽ,",
            "গোরা বḓঅ দয়ার ঠাকুর ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "କଲିଘୋର ତିମିରେ,    ଗରାସଲ ଜଗଜନ,",
            "ଧରମ କରମ ରହୁ ଦୂର",
            "ଅସାଧନେ ଚିନ୍ତାମଣି,    ବିଧି ମିଲାଓଲ ଆନିଽ,",
            "ଗୋରା ବḓଅ ଦୟାର ଠାକୁର ୧"
          ]
        },
        {
          "script_code": "Gujr",
