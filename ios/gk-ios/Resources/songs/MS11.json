      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "ब्रजबनसुधाकर,    ब्रजबनॆर ईश्बर,",
            "ब्रजॆश्बरी आमार ईश्बरी",
            "ललिता तांहार सखी,    तुल्य ताऽर नाहि लिखि,",
            "बिशाखा शिक्षिकापद धरि १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "ব্রজবনসুধাকর,    ব্রজবনের ঈশ্বর,",
            "ব্রজেশ্বরী আমার ঈশ্বরী",
            "ললিতা তাংহার সখী,    তুল্য তাঽর নাহি লিখি,",
            "বিশাখা শিক্ষিকাপদ ধরি ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
