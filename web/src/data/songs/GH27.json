      "source_text_master": [
        "bimala[FLAG_HYPHEN_ALPHA]hema[FLAG_HYPHEN_ALPHA]jini’,    tanu anupama re!",
        "tāhe śobhe nānā phula[FLAG_HYPHEN_ALPHA]dāma",
