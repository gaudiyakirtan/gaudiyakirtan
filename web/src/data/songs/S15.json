      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "‘अहंऽ‘ममऽशब्दअर्थॆ याहा किछु हय",
            "अर्पिलुं तॊमार पदॆ ऒहॆ दयामय १",
            "‘आमारऽ आमि तऽ नाथ! ना रहिनु आर",
            "ऎखन हइनु आमि कॆबल तॊमार २"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "‘অহংঽ‘মমঽশব্দঅর্থে যাহা কিছু হয়",
            "অর্পিলুং তোমার পদে ওহে দয়াময় ১",
            "‘আমারঽ আমি তঽ নাথ! না রহিনু আর",
            "এখন হইনু আমি কেবল তোমার ২"
