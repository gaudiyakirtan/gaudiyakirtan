    {
      "verse_number": 1,
      "source_text_master": [
        "ohe!",
        "baiṣṇaba ṭhākura,    dayāra sāgara,",
        "e dāse karuṇā kari’",
        "diyā padachāyā,    śodha he āmāre,",
        "tomāra caraṇa dhari 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O Vaiṣṇava Ṭhākura, you are an ocean of mercy. Being compassionate upon this servant, purify me by giving me the shade of your feet, of which I take hold."
          ]
        }
      ],
