    {
      "verse_number": 1,
      "source_text_master": [
        "rūpera bairāgyakāle,    sanātana bandiśāle,",
        "biṣāda bhābaye mane mane",
        "“śrīrūpe karuṇā kari’,    trāṇa kaila gaurahari,",
        "mo adhame nahila smaraṇe 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "रूपॆर बैराग्यकालॆ,    सनातन बन्दिशालॆ,",
            "बिषाद भाबयॆ मनॆ मनॆ",
            "“श्रीरूपॆ करुणा करिऽ,    त्राण कैल गौरहरि,",
            "मॊ अधमॆ नहिल स्मरणॆ १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "রূপের বৈরাগ্যকালে,    সনাতন বন্দিশালে,",
            "বিষাদ ভাবয়ে মনে মনে",
            "“শ্রীরূপে করুণা করিঽ,    ত্রাণ কৈল গৌরহরি,",
            "মো অধমে নহিল স্মরণে ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ରୂପେର ବୈରାଗ୍ୟକାଲେ,    ସନାତନ ବନ୍ଦିଶାଲେ,",
            "ବିଷାଦ ଭାବୟେ ମନେ ମନେ",
            "“ଶ୍ରୀରୂପେ କରୁଣା କରିଽ,    ତ୍ରାଣ କୈଲ ଗୌରହରି,",
            "ମୋ ଅଧମେ ନହିଲ ସ୍ମରଣେ ୧"
          ]
        },
        {
          "script_code": "Gujr",
          "standard": null,
          "text": [
            "રૂપેર બૈરાગ્યકાલે,    સનાતન બન્દિશાલે,",
            "બિષાદ ભાબયે મને મને",
            "“શ્રીરૂપે કરુણા કરિઽ,    ત્રાણ કૈલ ગૌરહરિ,",
            "મો અધમે નહિલ સ્મરણે ૧"
          ]
        },
        {
          "script_code": "Latn",
