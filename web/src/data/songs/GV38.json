    {
      "verse_number": 3,
      "source_text_master": [
        "paścāte agādha[FLAG_HYPHEN_ALPHA]jala,    dui pāśe dābānala,",
        "sammukhe yuḓila byādha bāṇa",
        "kātare hariṇī ḍāke,    paḓiyā biṣama pāke,",
        "tumi nātha more kara trāṇa 3"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "पश्चातॆ अगाधजल,    दुइ पाशॆ दाबानल,",
            "सम्मुखॆ युḓइल ब्याध बाण",
            "कातरॆ हरिणी डाकॆ,    पḓइया बिषम पाकॆ,",
            "तुमि नाथ मॊरॆ कर त्राण ३"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "পশ্চাতে অগাধজল,    দুই পাশে দাবানল,",
            "সম্মুখে যুḓইল ব্যাধ বাণ",
            "কাতরে হরিণী ডাকে,    পḓইয়া বিষম পাকে,",
            "তুমি নাথ মোরে কর ত্রাণ ৩"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ପଶ୍ଚାତେ ଅଗାଧଜଲ,    ଦୁଇ ପାଶେ ଦାବାନଲ,",
