      "source_text_master": [
        "bhāire!",
        "śarīra abidyā[FLAG_HYPHEN_ALPHA]jāla,    jaḓendriya tāhe kāla,",
        "jībe phele biṣaya[FLAG_HYPHEN_ALPHA]sāgare",
