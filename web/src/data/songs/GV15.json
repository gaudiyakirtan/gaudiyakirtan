            "ତରୁରାଜିତଚିନ୍ମୟଧାମଚରଂ",
            "ପ୍ରଣମାମି ହ କେଶବପୂତପଦମ୍ ୧"
          ]
        },
        {
          "script_code": "Gujr",
          "standard": null,
          "text": [
