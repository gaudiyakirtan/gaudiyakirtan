      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "चिरमुक्तगणाद्ड़्तकाम्यधनं",
            "धनदॆप्सितवन्दितकल्पतरुम्",
            "तरुराजितचिन्मयधामचरं",
            "प्रणमामि ह कॆशवपूतपदम् १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "চিরমুক্তগণাদ্ড়্তকাম্যধনং",
            "ধনদেপ্সিতবন্দিতকল্পতরুম্",
            "তরুরাজিতচিন্ময়ধামচরং",
            "প্রণমামি হ কেশবপূতপদম্ ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
