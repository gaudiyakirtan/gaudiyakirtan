      "verse_number": 1,
      "source_text_master": [
        "nācere nācere nitāi gaura dbijamaṇiyā",
        "bāme priya gadādhara,    śrībāsa adbaitabara,",
        "pāriṣada tārāgaṇa jiniyā 1"
