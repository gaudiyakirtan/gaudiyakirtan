      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "नाचॆरॆ नाचॆरॆ निताइ गौर द्बिजमणिया",
            "बामॆ प्रिय गदाधर,    श्रीबास अद्बैतबर,",
            "पारिषद तारागण जिनिया १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "নাচেরে নাচেরে নিতাই গৌর দ্বিজমণিয়া",
            "বামে প্রিয় গদাধর,    শ্রীবাস অদ্বৈতবর,",
            "পারিষদ তারাগণ জিনিয়া ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
