    {
      "verse_number": 2,
      "source_text_master": [
        "guru[FLAG_HYPHEN_ALPHA]mukhapadma[FLAG_HYPHEN_ALPHA]bākya,    cittete kariyā aikya,",
        "āra nā kariha mane āśā",
        "śrīguru[FLAG_HYPHEN_ALPHA]caraṇe rati,    ei sei uttamā gati,",
        "ye[FLAG_HYPHEN_ALPHA]prasāde pūre sarba āśā 2"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Make the words emanating from the lotus mouth of śrī guru one with your heart and do not aspire for anything else. Attachment to the lotus feet of śrī guru is the greatest attainment. By his mercy, all desires are fulfilled."
          ]
        }
      ],
