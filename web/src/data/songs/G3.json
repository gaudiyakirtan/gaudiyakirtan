      "verse_number": 1,
      "source_text_master": [
        "śrīguru[FLAG_HYPHEN_ALPHA]caraṇa[FLAG_HYPHEN_ALPHA]padma,    kebala bhakati[FLAG_HYPHEN_ALPHA]sadma,",
        "bando muĩ sābadhāna[FLAG_HYPHEN_ALPHA]mate",
        "yā̃hāra prasāde bhāi,    e bhaba tariyā yāi,",
        "kṛṣṇa[FLAG_HYPHEN_ALPHA]prāpti haya yā̃hā ha’te 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "The lotus feet of śrī guru are the treasure house of unalloyed prema-bhakti. I worship those lotus feet with great care. By the mercy of śrī guru, O brother, one can cross over the material universe and attain Śrī Kṛṣṇa."
          ]
        }
      ],
