    {
      "verse_number": 2,
      "source_text_master": [
        "śrīnibāsa dāmodara śrīrāma murāre",
        "nandanandana mādhaba nṛsiṁha kaṁsāre"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O Śrīnivāsa, Dāmodara, Śrī Rāma, Murāri, Nanda-nandana, Mādhava, Nṛsiṁha, Kaṁsāri!"
          ]
        }
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
