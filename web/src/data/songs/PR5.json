      "verse_number": 1,
      "source_text_master": [
        "bhāire!",
        "ekadina nīlācale,    prasāda sebana[FLAG_HYPHEN_ALPHA]kāle,",
        "mahāprabhu śrīkṛṣṇacaitanya",
        "balilena,—“bhaktagaṇe,    khecarānna śuddhamane,",
        "sebā kari’ hao āja dhanya 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "O brothers! One day in Jagannātha Purī, at the time of honoring the Lord’s prasāda, Mahāprabhu Śrī Kṛṣṇa Caitanya proclaimed, “O devotees, may you become blessed today by honoring the khicuḓi (rice and lentils cooked together) of the Lord in a pure state of mind."
          ]
        }
      ],
