    {
      "verse_number": 2,
      "source_text_master": [
        "khecarānna, piṭhāpānā,    apūrba prasāda nānā,",
        "jagannātha dila tomā sabe",
        "ākaṇṭha bhojana kari’,    bala mukhe hari hari,",
        "abidyā[FLAG_HYPHEN_ALPHA]durita nāhi rabe 2"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "“Lord Jagannātha has given you many varieties of extraordinary prasāda, such as khicuḓi  and piṭhā-pānā (coconut cake rolls in sweetened condensed milk). Take this prasāda until you are filled to the neck, and with your mouth chant, ‘Hari! Hari!’ Ignorance and sin will not be able to remain."
          ]
        }
      ],
