        "koṭīyuge kṛṣṇagehe gati 3"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "सॆ यॆ क्ड़्ष्णप्राणॆश्बरी,    क्ड़्ष्णप्राणाह्लादकरी,",
            "ह्लादिनी स्बरूपशक्ति सती",
            "तांहार चरण त्यजिऽ,    यदि क्ड़्ष्णचन्द्र भजि,",
            "कॊटीयुगॆ क्ड़्ष्णगॆहॆ गति ३"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "সে যে ক্ড়্ষ্ণপ্রাণেশ্বরী,    ক্ড়্ষ্ণপ্রাণাহ্লাদকরী,",
            "হ্লাদিনী স্বরূপশক্তি সতী",
            "তাংহার চরণ ত্যজিঽ,    যদি ক্ড়্ষ্ণচন্দ্র ভজি,",
            "কোটীয়ুগে ক্ড়্ষ্ণগেহে গতি ৩"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
