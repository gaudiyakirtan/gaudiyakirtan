    {
      "verse_number": 3,
      "source_text_master": [
        "se ye kṛṣṇa[FLAG_HYPHEN_ALPHA]prāṇeśbarī,    kṛṣṇa[FLAG_HYPHEN_ALPHA]prāṇāhlādakarī,",
        "hlādinī sbarūpaśakti satī",
