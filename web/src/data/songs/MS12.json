      "verse_number": 1,
      "source_text_master": [
        "saundarya[FLAG_HYPHEN_ALPHA]kiraṇamālā,    jine rati, gaurī, līlā,",
        "anāyāse sbarūpabaibhabe",
        "śacī, lakṣmī, satyabhāmā,    yata bhāgyabatī rāmā,",
        "saubhāgya[FLAG_HYPHEN_ALPHA]balane parābhabe 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "सौन्दर्यकिरणमाला,    जिनॆ रति, गौरी, लीला,",
            "अनायासॆ स्बरूपबैभबॆ",
            "शची, लक्ष्मी, सत्यभामा,    यत भाग्यबती रामा,",
            "सौभाग्यबलनॆ पराभबॆ १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "সৌন্দর্যকিরণমালা,    জিনে রতি, গৌরী, লীলা,",
            "অনায়াসে স্বরূপবৈভবে",
            "শচী, লক্ষ্মী, সত্যভামা,    যত ভাগ্যবতী রামা,",
            "সৌভাগ্যবলনে পরাভবে ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ସୌନ୍ଦର୍ୟକିରଣମାଲା,    ଜିନେ ରତି, ଗୌରୀ, ଲୀଲା,",
            "ଅନାୟାସେ ସ୍ବରୂପବୈଭବେ",
            "ଶଚୀ, ଲକ୍ଷ୍ମୀ, ସତ୍ୟଭାମା,    ଯତ ଭାଗ୍ୟବତୀ ରାମା,",
            "ସୌଭାଗ୍ୟବଲନେ ପରାଭବେ ୧"
          ]
        },
        {
          "script_code": "Gujr",
          "standard": null,
          "text": [
            "સૌન્દર્યકિરણમાલા,    જિને રતિ, ગૌરી, લીલા,",
            "અનાયાસે સ્બરૂપબૈભબે",
