        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "xxx श्रील रूप गॊस्वामी",
            "भ्रातुरन्तकस्य पत्तनॆऽभिपत्तिहारिणी",
            "प्रॆक्षयातिपापिनॊऽपि पापसिन्धुतारिणी",
            "नीरमाधुरीभिरप्यशॆषचित्तबन्धिनी",
