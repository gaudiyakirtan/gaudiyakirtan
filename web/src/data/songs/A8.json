      "verse_number": 1,
      "source_text_master": [
        "yaśomatī[FLAG_HYPHEN_ALPHA]nandana,    brajabara[FLAG_HYPHEN_ALPHA]nāgara,",
        "gokula[FLAG_HYPHEN_ALPHA]rañjana kāna",
        "gopī[FLAG_HYPHEN_ALPHA]parāṇadhana,    madana[FLAG_HYPHEN_ALPHA]manohara,",
        "kālīya[FLAG_HYPHEN_ALPHA]damana[FLAG_HYPHEN_ALPHA]bidhāna 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Kṛṣṇa is the beloved son of Mother Yaśodā, the topmost hero of Vraja, the delight of Gokula, and Kāna [an affectionate nickname for Kṛṣṇa]. He is the treasure of the lives of the gopīs, the enchanter of Cupid, and the punisher of the serpent Kālīya."
          ]
        }
      ],
