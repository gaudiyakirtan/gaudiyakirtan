    {
      "verse_number": 1,
      "source_text_master": [
        "śrīkṛṣṇacaitanya,    balarāma nityānanda,",
        "pāriṣada[FLAG_HYPHEN_ALPHA]saṅge abatāra",
        "golokera premadhana,    sabāre yāciyā dila,",
        "nā la·inu muĩ durācāra 1"
      ],
      "display_scripts": [
        {
          "script_code": "Deva",
          "standard": null,
          "text": [
            "श्रीक्ड़्ष्णचैतन्य,    बलराम नित्यानन्द,",
            "पारिषदसङ्गॆ अबतार",
            "गॊलॊकॆर प्रॆमधन,    सबारॆ याचिया दिल,",
            "ना लइनु मुइं दुराचार १"
          ]
        },
        {
          "script_code": "Beng",
          "standard": null,
          "text": [
            "শ্রীক্ড়্ষ্ণচৈতন্য,    বলরাম নিত্যানন্দ,",
            "পারিষদসঙ্গে অবতার",
            "গোলোকের প্রেমধন,    সবারে যাচিয়া দিল,",
            "না লইনু মুইং দুরাচার ১"
          ]
        },
        {
          "script_code": "Orya",
          "standard": null,
          "text": [
            "ଶ୍ରୀକ୍ଡ଼୍ଷ୍ଣଚୈତନ୍ୟ,    ବଲରାମ ନିତ୍ୟାନନ୍ଦ,",
            "ପାରିଷଦସଙ୍ଗେ ଅବତାର",
            "ଗୋଲୋକେର ପ୍ରେମଧନ,    ସବାରେ ଯାଚିୟା ଦିଲ,",
            "ନା ଲଇନୁ ମୁଇଂ ଦୁରାଚାର ୧"
          ]
        },
        {
          "script_code": "Gujr",
          "standard": null,
          "text": [
