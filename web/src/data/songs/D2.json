    {
      "verse_number": 2,
      "source_text_master": [
        "śbapaca[FLAG_HYPHEN_ALPHA]gṛhete,    māgiyā khāiba,",
        "piba sarasbatī[FLAG_HYPHEN_ALPHA]jala",
        "puline puline,    gaḓāgaḓi diba,",
        "kari’ kṛṣṇa[FLAG_HYPHEN_ALPHA]kolāhala 2"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "I shall eat by begging from the homes of the untouchables and drink water from the Sarasvatī River. I shall roll on the ground on the river’s bank, loudly calling out Śrī Kṛṣṇa’s names."
          ]
        }
      ],
