      "source_text_master": [
        "kabe gaura[FLAG_HYPHEN_ALPHA]bane,    suradhunī[FLAG_HYPHEN_ALPHA]taṭe,",
        "‘hā rādhe, hā kṛṣṇa’ bale",
        "kā̃diyā beḓā’ba,    deha[FLAG_HYPHEN_ALPHA]sukha chāḓi’,",
        "nānā latā[FLAG_HYPHEN_ALPHA]tarutale 1"
      ],
      "translations": [
        {
          "language_code": "eng",
          "text": [
            "Oh, when, giving up all bodily pleasures, will I wander under various trees and vines on the banks of the Suradhunī [Gaṅgā] in Gaura-vana [Śrī Navadvīpa-dhāma], weeping and calling out, “Hā Rādhe! Hā Kṛṣṇa!”?"
          ]
        }
      ],
